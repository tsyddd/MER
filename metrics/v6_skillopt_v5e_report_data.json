t"}, {"step": 8, "epoch": 2, "module": "reflect"}], "rejected": [{"step": 1, "epoch": 1, "module": "first"}, {"step": 2, "epoch": 1, "module": "first"}, {"step": 4, "epoch": 1, "module": "first"}, {"step": 5, "epoch": 2, "module": "first"}, {"step": 5, "epoch": 2, "module": "relook"}], "skill_sha256": "8da2df63bcddb73a9885ab474f6bbb2483af2051de76276e301d5f0832ff061b", "skill_chars": 1452}, "summary_epoch1.json": {"provider": "gemini", "steps": 4, "val_baseline": 20, "val_final": 26, "val_n": 47, "accepted": [{"step": 1, "module": "relook"}, {"step": 1, "module": "reflect"}, {"step": 3, "module": "first"}, {"step": 3, "module": "relook"}, {"step": 3, "module": "reflect"}, {"step": 4, "module": "reflect"}], "rejected": [{"step": 1, "module": "first"}, {"step": 2, "module": "first"}, {"step": 4, "module": "first"}], "skill_sha256": "4b9033ca4162a831181a93d6affcdfe248e71a275a71f8f6622a939a83dcbd53", "skill_chars": 1094}, "best_skill.json": {"first": "【核心情绪基准与区分】①悲伤与担忧：若眼含泪光、嘴角下垂或声带哭腔抽噎，实质生理情绪为sadness，切勿因台词追问或对现实发愁而误判为worried。②喜悦与中性：日常交互中的客套浅笑、惯性调侃若缺乏兴奋由衷的高能量宣泄，应归为neutral。③惊讶与愤怒：面对反转以错愕求证、吸气反问为核心的属于surprise，切勿因语速急促误判为angry；而在对质控诉中带有冷笑咬牙、悲愤发颤的克制怒意属于angry，不可误判为单纯sadness或neutral。\n【不确定点提报准则】当候选标签在上述情绪临界点摇摆时，首答不可武断定论，应锁定句首发声或神态突变的瞬间窗口发起回看，具体提问是否存在瞬间抽气、哭颤、冷峻咬字或由衷愉悦舒展等关键微动态。", "reflect": "【改判与维持准则】反思首答依赖的证据时，需甄别生理性反应与主观情绪：若“皱眉、闭眼、叹气、撇嘴”或扶靠喘息等线索实质由身体牵拉、轻微痛感或体力消耗喘息（如运动后的急促换气、尾音脱力）等即时生理反应引起，而非主观情感宣泄，应果断推翻悲伤等情绪归因改判中性；仅在回看观察到持续明确的情感生理特征时方支持情绪判定。\n若回看在起始段定位到抽气、惊愕叹音或证实眉眼仅为错愕圆睁，削弱了首答基于字面攻击性所认定的怒意时，可改判为surprise。若回看未发现排他性的反向新证据，而仅是细化并强化了首答的核心特征（如哭腔抽噎或关切救助动作更明确），则必须坚定维持原判（KEEP）。\n若首答因台词涉及严重后果、排比反问或重音加力而倾向于worried、surprise或angry，但回看证实语调浑厚沉稳或从容自若、无惊愕吸气、忧惧发颤或敌意失控，且面部肌群平稳端方，实属理性陈述利害或寻常表态，应削弱台词与修辞张力，果断改判为neutral。\n若首答将急促反驳或自白辩解误判为angry，但回看证实缺乏持续攻击性敌意且后文转向日常解释，应推翻愤怒改判neutral；若首答因眉形微蹙偏向悲伤，但回看显示嘴角微翘带有一丝自得或幸灾乐祸的笑意微表情，应果断推翻sad改判happy。\n若首答因闭眼叹气或语调低沉发闷而判定为sadness，但回看结合情境证实实为对荒唐阻碍或添乱事实的懊恼排斥与不耐烦质问，应果断推翻悲伤改判为克制恼火（anger）。\n【低唤醒情绪维持准则】生活化场景中伴随日常事务展开的低唤醒交谈，人物常以放松自若的体态呈现情绪。若首答已准确定位到由语义反问与语调轻微上挑传递的错愕（surprise），或由犹豫试探与谨慎声线流露的顾虑（worried），且回看未见排他性反向证据，不可仅因动作连贯自若或未见夸张肌群形变而改判为neutral，应坚定维持原判（KEEP）。", "relook": "【微表情与声调核查】回看密集帧与音频时，重点核验发声瞬间的核心肌肉动态与声调变化：检查眉心是否持续紧缩、眼眶是否突发睁大发愣、嘴角是自然微闭还是撇嘴颤抖。若复查发现面部肌群无持续形变、语调缺乏真切起伏，应认定为平稳中性，避免对短暂瞬态动作过度解读。\n回看时重点检索发话前及句首瞬间的声学特征，辨析是否存在惊愕抽气、短暂停顿或声音颤抖，排查声调是否存在怒气爆发的硬度、咬牙冷峻或悲愤颤抖；结合连续体态与微表情，辨析眼神是错愕发愣还是施压对峙，警惕以冷笑、抿唇下压或克制声线呈现的内敛怒意，不可仅因缺乏咆哮或大幅度肌肉扭曲便轻率排除愤怒。若未发现新微表情，如实记录无新增线索。\n同理，警惕在神情克制下以目光凝滞泛泪、唇角微颤或尾音极轻幽咽呈现的内敛悲伤，不可因缺乏嚎啕哭泣而轻率误判为平淡中性。"}, "best_skill_epoch1.json": {"first": "【核心情绪基准与区分】①悲伤与担忧：若眼含泪光、嘴角下垂或声带哭腔抽噎，实质生理情绪为sadness，切勿因台词追问或对现实发愁而误判为worried。②喜悦与中性：日常交互中的客套浅笑、惯性调侃若缺乏兴奋由衷的高能量宣泄，应归为neutral。③惊讶与愤怒：面对反转以错愕求证、吸气反问为核心的属于surprise，切勿因语速急促误判为angry；而在对质控诉中带有冷笑咬牙、悲愤发颤的克制怒意属于angry，不可误判为单纯sadness或neutral。\n【不确定点提报准则】当候选标签在上述情绪临界点摇摆时，首答不可武断定论，应锁定句首发声或神态突变的瞬间窗口发起回看，具体提问是否存在瞬间抽气、哭颤、冷峻咬字或由衷愉悦舒展等关键微动态。", "reflect": "【改判与维持准则】反思首答依赖的证据时，需甄别生理性反应与主观情绪：若“皱眉、闭眼、叹气、撇嘴”等线索实质由身体牵拉、轻微痛感等即时生理不适引起，或是生活化口癖而非主观情绪宣泄，应果断推翻情绪归因改判中性；仅在回看观察到持续明确的情感生理特征时方支持情绪判定。\n若回看在起始段定位到抽气、惊愕叹音或证实眉眼仅为错愕圆睁，削弱了首答基于字面攻击性所认定的怒意时，可改判为surprise。若回看未发现排他性的反向新证据，而仅是细化并强化了首答的核心特征（如哭腔抽噎或关切救助动作更明确），则必须坚定维持原判（KEEP）。\n若首答因台词排比感叹或重音强调而倾向于surprise或angry，但回看证实语调浑厚沉稳、无惊愕吸气或失控起伏，且发话完毕后面部肌群平稳复位、神态自若端方，应削弱由修辞张力引发的情绪归因，果断改判为neutral。\n若首答将急促反驳或自白辩解误判为angry，但回看证实缺乏持续攻击性敌意且后文转向日常解释，应推翻愤怒改判neutral；若首答因眉形微蹙偏向悲伤，但回看显示嘴角微翘带有一丝自得或幸灾乐祸的笑意微表情，应果断推翻sad改判happy。", "relook": "【微表情与声调核查】回看密集帧与音频时，重点核验发声瞬间的核心肌肉动态与声调变化：检查眉心是否持续紧缩、眼眶是否突发睁大发愣、嘴角是自然微闭还是撇嘴颤抖。若复查发现面部肌群无持续形变、语调缺乏真切起伏，应认定为平稳中性，避免对短暂瞬态动作过度解读。\n回看时重点检索发话前及句首瞬间的声学特征，辨析是否存在惊愕抽气、短暂停顿或声音颤抖，排查声调是否存在怒气爆发的硬度、咬牙冷峻或悲愤颤抖；结合连续体态与微表情，辨析眼神是错愕发愣还是施压对峙，警惕以冷笑、抿唇下压或克制声线呈现的内敛怒意，不可仅因缺乏咆哮或大幅度肌肉扭曲便轻率排除愤怒。若未发现新微表情，如实记录无新增线索。"}, "labels": {"train": {"MER2024": {"happy": 10, "surprise": 11, "worried": 13, "neutral": 16, "angry": 10, "sad": 12}, "MELD": {"sadness": 7, "neutral": 30, "joy": 10, "surprise": 9, "anger": 8, "disgust": 1}}, "val": {"MER2024": {"sad": 9, "worried": 4, "surprise": 3, "neutral": 7, "angry": 1, "happy": 1}, "MELD": {"joy": 4, "surprise": 2, "disgust": 1, "sadness": 4, "anger":